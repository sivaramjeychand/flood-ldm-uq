{
    // True zero-shot cross-catchment eval: the published Wollombi checkpoint (I400000_E2920),
    // run with -p test only, against Chowilla's test-only "_1k" split. NO retraining/fine-tuning
    // happens here -- unlike config/wollombi-chowilla.json, whose resume_state (I450000_E3063)
    // points at an unpublished checkpoint that already has 50k extra fine-tuning steps on Chowilla.
    // `sr.py -p test` never reads the "train" block, so it is left identical to wollombi-trnf.json
    // for reference only.
    "name": "wollombi-zeroshot-chowilla",
    "phase": "test",
    "distributed": false,
    "amp": true,
    "latent": true,
    "dem": true,
    "path": {
        "log": "logs",
        "tb_logger": "tb_logger",
        "results": "results",
        "checkpoint": "checkpoint",
        "resume_state": "../checkpoints/wollombi/I400000_E2920",
        "vae_state": "../checkpoints/vae/vae.pth",
        "vae_dem_state": "../checkpoints/vae/vae_dem.pth"
    },
    "datasets": {
        "meta": {
            "max_depth": 3200,
            "dem_max_value": 440,
            "dem_min_value": -20,
            "norm_min": -1,
            "norm_max": 1,
            "channels": 1,
            "image_size": 512
        },
        "train": {
            "catchment": "Wollombi Latent",
            "dataroot": "../data/wollombi_latent", // unused in -p test; kept for reference/consistency with wollombi-trnf.json
            "batch_size": 256,
            "num_workers": 1,
            "use_shuffle": true,
            "data_len": -1
        },
        "test": {
            "catchment": "Chowilla (zero-shot from Wollombi)",
            "dataroot": "../data/chowilla",
            "batch_size": 40,
            "use_shuffle": false,
            "data_len": 1000, // full test period downloaded (49400 scenes), not the "_1k" subsample; capped here to preserve original quick-eval intent -- set to -1 for the full test set
            "epochs": 1
        }
    },
    "model": {
        "which_model_G": "ddpm",
        "finetune_norm": false,
        "unet": {
            "in_channel": 12,
            "out_channel": 4,
            "inner_channel": 64,
            "norm_groups": 16,
            "channel_multiplier": [
                1,
                2,
                4,
                8,
                16
            ],
            "attn_res": [
                16
            ],
            "res_blocks": 1,
            "dropout": 0
        },
        "beta_schedule": {
            "train": {
                "schedule": "linear",
                "n_timestep": 1000,
                "linear_start": 1e-6,
                "linear_end": 1e-2
            },
            "test": {
                "schedule": "linear",
                "n_timestep": 1000,
                "backward_start": 50,
                "linear_start": 1e-6,
                "linear_end": 1e-2
            }
        },
        "diffusion": {
            "image_size": 64,
            "loss_type": "l2",
            "conditional": true
        }
    },
    "train": {
        "n_iter": 400000,
        "val_freq": 2e4,
        "save_checkpoint_freq": 2e4,
        "print_freq": 500,
        "optimizer": {
            "type": "adam",
            "lr": 1e-6,
            "lr_scheduler": {
                "schedule": "linear_warmup",
                "until": 10000
            }
        }
    },
    "test": {
        "save_results": false,
        "thresholds": [5, 30]
    }
}
